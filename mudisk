#!/bin/bash

winC=0
winD=0
winX=0
exp=0
pls=0
txt=0
pic=0
aud=0
sda=0
sdo=0
sdp=0
sds=0
sdt=0
sdu=0
sdv=0
sdw=0
sdx=0
sdz=0
mnt=1
RWRO="ro"

while getopts "abcdeEilmopstuvwxzUR" opt; do
    case $opt in
        b)
           winX=1 ;;
        c)
           winC=1 ;;
        d)
           winD=1 ;;
        e)
           txt=1 ;;
        i)
           winX=1
           pic=1 ;;
        E)
           exp=1 ;;
        l)
           pls=1 ;;
        m)
           winX=1
           aud=1 ;;
        o)
           sdo=1 ;;
        p)
           sdp=1 ;;
        s)
           sds=1 ;;
        t)
           sdt=1 ;;
        u)
           sdu=1 ;;
        v)
           sdv=1 ;;
        w)
           sdw=1 ;;
        x)
           sdx=1 ;;
        z)
           sdz=1 ;;
        U)
           mnt=0 ;;
        R)
           RWRO="rw" ;;
        a)
           sda=1
          winC=1
          winD=1
          winX=1
           txt=1
           pic=1
           aud=1
           sdo=1
           sdp=1
           sds=1
           sdt=1
           sdu=1
           sdv=1
           sdw=1
           sdx=1
           sdz=1
           ;;
        ?)
           echo 'mudisk -[abcdeEilmopstuvwxzUR]'
           exit 1 ;;
    esac
done

shift $((OPTIND-1))  #This tells getopts to move on to the next argument.

#export /media/simone tree files
if [ $exp -eq 1 ] && [ $sda -eq 1 ]; then
    tree -f -L 2 /media/simone > /opt/misc/docs/files-sandisks
    echo "tree to files-sandisks!"
    exit 0
fi

wcb=$(ls /media/simone/winX       2>/dev/null | wc -l)
wcc=$(ls /media/simone/winC       2>/dev/null | wc -l)
wcd=$(ls /media/simone/winD       2>/dev/null | wc -l)
wco=$(ls /media/simone/sandisk_o  2>/dev/null | wc -l)
wcp=$(ls /media/simone/sandisk_p  2>/dev/null | wc -l)
wcs=$(ls /media/simone/sandisk_s  2>/dev/null | wc -l)
wct=$(ls /media/simone/sandisk_t  2>/dev/null | wc -l)
wcu=$(ls /media/simone/sandisk_u  2>/dev/null | wc -l)
wcv=$(ls /media/simone/sandisk_v  2>/dev/null | wc -l)
wcw=$(ls /media/simone/sandisk_w  2>/dev/null | wc -l)
wcx=$(ls /media/simone/sandisk_x1 2>/dev/null | wc -l)
wcz=$(ls /media/simone/sandisk_z  2>/dev/null | wc -l)
wce=$(ls /opt/.porn/epub/000      2>/dev/null | wc -l)
wca=$(ls /opt/.porn/asmr/asmr.mp3 2>/dev/null | wc -l)
wci=$(ls /media/simone/winX/pics/PIX  2>/dev/null | wc -l)

#list which process is occupying the mount point
if [ $pls -eq 1 ]; then
  [[ $winC == 1 ]] && [[ $wcc != 0 ]] && lsof /media/simone/winC       && echo -e "==winC-lsof\n"
  [[ $winD == 1 ]] && [[ $wcd != 0 ]] && lsof /media/simone/winD       && echo -e "==winD-lsof\n"
  [[ $winX == 1 ]] && [[ $wcb != 0 ]] && lsof /media/simone/winX       && echo -e "==winX-lsof\n"
  [[ $pic  == 1 ]] && [[ $wci != 0 ]] && lsof /media/simone/winX/pics  && echo -e "==winX/pics-lsof\n"
  [[ $pic  == 1 ]] && [[ $wci != 0 ]] && lsof /media/simone/winC/pics  && echo -e "==winC/pics-lsof\n"
  [[ $aud  == 1 ]] && [[ $wca != 0 ]] && lsof /media/simone/winX/asmr  && echo -e "==winX/asmr-lsof\n"
  [[ $aud  == 1 ]] && [[ $wca != 0 ]] && lsof /opt/.porn/asmr          && echo -e "==porn/asmr-lsof\n"
  [[ $txt  == 1 ]] && [[ $wce != 0 ]] && lsof /opt/.porn/epub          && echo -e "==epub-lsof\n"
  [[ $sdo  == 1 ]] && [[ $wco != 0 ]] && lsof /media/simone/sandisk_o  && echo -e "==ooo-lsof\n"
  [[ $sdp  == 1 ]] && [[ $wcp != 0 ]] && lsof /media/simone/sandisk_p  && echo -e "==ppp-lsof\n"
  [[ $sds  == 1 ]] && [[ $wcs != 0 ]] && lsof /media/simone/sandisk_s  && echo -e "==sss-lsof\n"
  [[ $sdt  == 1 ]] && [[ $wct != 0 ]] && lsof /media/simone/sandisk_t  && echo -e "==ttt-lsof\n"
  [[ $sdu  == 1 ]] && [[ $wcu != 0 ]] && lsof /media/simone/sandisk_u  && echo -e "==uuu-lsof\n"
  [[ $sdv  == 1 ]] && [[ $wcv != 0 ]] && lsof /media/simone/sandisk_v  && echo -e "==vvv-lsof\n"
  [[ $sdw  == 1 ]] && [[ $wcw != 0 ]] && lsof /media/simone/sandisk_w  && echo -e "==www-lsof\n"
  [[ $sdx  == 1 ]] && [[ $wcx != 0 ]] && lsof /media/simone/sandisk_x1 && echo -e "==xx1-lsof\n"
  [[ $sdx  == 1 ]] && [[ $wcx != 0 ]] && lsof /media/simone/sandisk_x2 && echo -e "==xx2-lsof\n"
  [[ $sdz  == 1 ]] && [[ $wcz != 0 ]] && lsof /media/simone/sandisk_z  && echo -e "==zzz-lsof\n"

  exit 0
fi

#umount the specific mount point
if [ $mnt -eq 0 ]; then
  [[ $winC == 1 ]] && [[ $wcc != 0 ]] && echo winC/pics-umnt && sudo umount /media/simone/winC/pics
  [[ $winC == 1 ]] && [[ $wcc != 0 ]] && echo winC/vids-umnt && sudo umount /media/simone/winC/vids
  [[ $winD == 1 ]] && [[ $wcd != 0 ]] && echo winD-umnt      && sudo umount /media/simone/winD
  [[ $winX == 1 ]] && [[ $wcb != 0 ]] && echo winX/asmr-umnt && sudo umount /media/simone/winX/asmr
  [[ $winX == 1 ]] && [[ $wcb != 0 ]] && echo winX/pics-umnt && sudo umount /media/simone/winX/pics
  [[ $txt  == 1 ]] && [[ $wce != 0 ]] && echo epub-umnt      && sudo umount /opt/.porn/epub
  [[ $sdo  == 1 ]] && [[ $wco != 0 ]] && echo sdo-umnt       && sudo umount /media/simone/sandisk_o
  [[ $sdp  == 1 ]] && [[ $wcp != 0 ]] && echo sdp-umnt       && sudo umount /media/simone/sandisk_p
  [[ $sds  == 1 ]] && [[ $wcs != 0 ]] && echo sds-umnt       && sudo umount /media/simone/sandisk_s
  [[ $sdt  == 1 ]] && [[ $wct != 0 ]] && echo sdt-umnt       && sudo umount /media/simone/sandisk_t
  [[ $sdu  == 1 ]] && [[ $wcu != 0 ]] && echo sdu-umnt       && sudo umount /media/simone/sandisk_u
  [[ $sdv  == 1 ]] && [[ $wcv != 0 ]] && echo sdv-umnt       && sudo umount /media/simone/sandisk_v
  [[ $sdw  == 1 ]] && [[ $wcw != 0 ]] && echo sdw-umnt       && sudo umount /media/simone/sandisk_w
  [[ $aud  == 1 ]] && [[ $wca != 0 ]] && echo asmr-umnt      && {
      sudo umount /opt/.porn/asmr
      sudo umount /media/simone/winX/asmr
  }
  [[ $pic  == 1 ]] && [[ $wci != 0 ]] && echo pics-umnt && {
      sudo umount /media/simone/winC/pics
      sudo umount /media/simone/winX/pics
  }
  [[ $sdx  == 1 ]] && [[ $wcx != 0 ]] && echo xxx-umnt  && {
      sudo umount /media/simone/sandisk_x1
      sudo umount /media/simone/sandisk_x2
  }
  [[ $sdz  == 1 ]] && [[ $wcz != 0 ]] && echo zzz-umnt  && sudo umount /media/simone/sandisk_z

  exit 0
fi

#mount the specific point when the .priv is not available
wcpriv=$(ls /opt/.priv/priv 2>/dev/null | wc -l)
if [ $wcpriv -eq 0 ]; then
  #mount winX manually
  if [[ $winX -eq 1 ]] && [[ $wcb -eq 0 ]]; then
    echo +winX+++
    sudo mount -o $RWRO,nosuid,nodev,relatime,fmask=0022,dmask=0022,uid=1000,gid=1000 /dev/nvme0n1p4 /media/simone/winX
  fi

  #mount winC manually
  if [[ $winC -eq 1 ]] && [[ $wcc -eq 0 ]]; then
    echo +winC+++
    sudo mount -o $RWRO,nosuid,nodev,relatime,fmask=0022,dmask=0022,uid=1000,gid=1000 /dev/nvme0n1p3 /media/simone/winC
  fi

  #mount winD manually
  if [[ $winD -eq 1 ]] && [[ $wcd -eq 0 ]]; then
    echo +winD+++
    sudo mount -o $RWRO,nosuid,nodev,relatime,fmask=0022,dmask=0022,uid=1000,gid=1000 /dev/nvme0n1p5 /media/simone/winD
  fi

  #mount epub manually
  if [ $txt -eq 1 ] && [ $wce -eq 0 ]; then
    echo +epub+++
    sudo mount -t ecryptfs /opt/.porn/epub /opt/.porn/epub -o ecryptfs_cipher=aes,ecryptfs_key_bytes=16,ecryptfs_passthrough=n,ecryptfs_enable_filename_crypto=y,ecryptfs_fnek_sig=85e5a0a7dcf6b743
  fi

  #mount pics manually
  if [ $pic -eq 1 ] && [ $wci -eq 0 ]; then
    echo +winX/pics+++
    sudo mount -t ecryptfs /media/simone/winX/pics /media/simone/winX/pics -o ecryptfs_cipher=aes,ecryptfs_key_bytes=16,ecryptfs_passthrough=n,ecryptfs_enable_filename_crypto=y,ecryptfs_fnek_sig=85e5a0a7dcf6b743

    if [[ $wcc -eq 0 ]]; then
      echo +winC/pics+++
      sudo mount -o $RWRO,nosuid,nodev,relatime,fmask=0022,dmask=0022,uid=1000,gid=1000 /dev/nvme0n1p3 /media/simone/winC
      sleep 1s
    fi

    sudo mount -t ecryptfs /media/simone/winC/pics /media/simone/winC/pics -o ecryptfs_cipher=aes,ecryptfs_key_bytes=16,ecryptfs_passthrough=n,ecryptfs_enable_filename_crypto=y,ecryptfs_fnek_sig=85e5a0a7dcf6b743
    sleep 1s

    sudo mount -t ecryptfs /media/simone/winC/asmr /media/simone/winC/asmr -o ecryptfs_cipher=aes,ecryptfs_key_bytes=16,ecryptfs_passthrough=n,ecryptfs_enable_filename_crypto=y,ecryptfs_fnek_sig=85e5a0a7dcf6b743
  fi

  #mount asmr manually
  if [ $aud -eq 1 ] && [ $wca -eq 0 ]; then
    sleep 1s
    echo +porn/asmr+++
    sudo mount -t ecryptfs /opt/.porn/asmr /opt/.porn/asmr -o ecryptfs_cipher=aes,ecryptfs_key_bytes=16,ecryptfs_passthrough=n,ecryptfs_enable_filename_crypto=y,ecryptfs_fnek_sig=85e5a0a7dcf6b743

    if [[ $wcb -eq 0 ]]; then
      echo +winX-auds+++
      sudo mount -o $RWRO,nosuid,nodev,relatime,fmask=0022,dmask=0022,uid=1000,gid=1000 /dev/nvme0n1p4 /media/simone/winX
      sleep 1s
    fi
    sudo mount -t ecryptfs /media/simone/winX/asmr /media/simone/winX/asmr -o ecryptfs_cipher=aes,ecryptfs_key_bytes=16,ecryptfs_passthrough=n,ecryptfs_enable_filename_crypto=y,ecryptfs_fnek_sig=85e5a0a7dcf6b743
  fi

  #mount sandisk_o manually
  if [ $sdo -eq 1 ] && [ $wco -eq 0 ] && [ -e /dev/disk/by-label/Sandisk_O ]; then
    echo +ooo+++
    sudo mount -o $RWRO,nosuid,nodev,relatime,stripe=32696,data=ordered,uhelper=udisks2 /dev/disk/by-label/Sandisk_O /media/simone/sandisk_o
  fi

  #mount sandisk_p manually
  if [ $sdp -eq 1 ] && [ $wcp -eq 0 ] && [ -e /dev/disk/by-uuid/d042e951-6889-412c-8b0d-c792593f7b20 ]; then
    echo +ppp+++
    sudo mount -o $RWRO,nosuid,nodev,relatime,stripe=32696,data=ordered,uhelper=udisks2 /dev/disk/by-uuid/d042e951-6889-412c-8b0d-c792593f7b20 /media/simone/sandisk_p
  fi

  #mount sandisk_o manually
  if [ $sdt -eq 1 ] && [ $wct -eq 0 ] && [ -e /dev/disk/by-label/Sandisk_T ]; then
    echo +ttt+++
    sudo mount -o $RWRO,nosuid,nodev,relatime,stripe=32696,data=ordered,uhelper=udisks2 /dev/disk/by-label/Sandisk_T /media/simone/sandisk_t
  fi

  #mount sandisk_s manually
  if [ $sds -eq 1 ] && [ $wcs -eq 0 ] && [ -e /dev/disk/by-uuid/EA1D-0944 ]; then
    echo +sss+++
    sudo mount -t exfat -o $RWRO,nosuid,nodev,relatime,fmask=0133,dmask=0022,codepage=437,iocharset=utf8,showexec,uid=1000,gid=1000 /dev/disk/by-uuid/EA1D-0944 /media/simone/sandisk_s
  fi

  #mount sandisk_u manually
  if [ $sdu -eq 1 ] && [ $wcu -eq 0 ] && [ -e /dev/disk/by-uuid/3166-6338 ]; then
    echo +uuu+++
    sudo mount -t vfat -o $RWRO,nosuid,nodev,relatime,fmask=0022,dmask=0022,codepage=437,iocharset=utf8,showexec,uid=1000,gid=1000 /dev/disk/by-uuid/3166-6338 /media/simone/sandisk_u
  fi

  #mount sandisk_v manually
  if [ $sdv -eq 1 ] && [ $wcv -eq 0 ] && [ -e /dev/disk/by-label/Sandisk_V ]; then
    echo +vvv+++
    sudo mount -o $RWRO,nosuid,nodev,relatime,data=ordered,uhelper=udisks2 /dev/disk/by-label/Sandisk_V /media/simone/sandisk_v
  fi

  #mount sandisk_w manually
  if [ $sdw -eq 1 ] && [ $wcw -eq 0 ] && [ -e /dev/disk/by-uuid/3534-6562 ]; then
  #if [ $sdw -eq 1 ] && [ $wcw -eq 0 ] && [ -e /dev/disk/by-label/udisk_hama ]; then
    echo +www+++
    sudo mount -o $RWRO,nosuid,nodev,relatime,stripe=32696,data=ordered,uhelper=udisks2 /dev/disk/by-uuid/3534-6562 /media/simone/sandisk_w
    #sudo mount -o $RWRO,nosuid,nodev,relatime,stripe=32696,data=ordered,uhelper=udisks2 /dev/disk/by-label/udisk_hama /media/simone/sandisk_w
  fi

  #mount sandisk_x manually
  if [ $sdx -eq 1 ] && [ $wcx -eq 0 ] && [ -e /dev/disk/by-label/sandisk_ext ]; then
    echo +xxx1+++
    sudo mount -o $RWRO,nosuid,nodev,relatime,stripe=32696,data=ordered,uhelper=udisks2 /dev/disk/by-label/sandisk_ext /media/simone/sandisk_x1

    sleep 1s
    echo +xxx2+++
    sudo mount -o $RWRO,nosuid,nodev,relatime,stripe=32696,data=ordered,uhelper=udisks2 /dev/disk/by-label/sandisk_exp /media/simone/sandisk_x2
  fi

  #mount sandisk_z manually
  if [ $sdz -eq 1 ] && [ $wcz -eq 0 ] && [ -e /dev/disk/by-label/sandisk_z ]; then
    echo +zzz+++
    sudo mount -o $RWRO,nosuid,nodev,relatime,stripe=32696,data=ordered,uhelper=udisks2 /dev/disk/by-label/sandisk_z /media/simone/sandisk_z
  fi

  exit 0
fi

#mount the specific point when the .priv is available
[ ! -f /opt/.priv/password ]   && exit 1 || password="$(< /opt/.priv/password)"
[ ! -f /opt/.priv/passphrase ] && exit 1 || passphrase="$(< /opt/.priv/passphrase)"

exist_sdp_src=0; [ -e /dev/disk/by-uuid/d042e951-6889-412c-8b0d-c792593f7b20 ]  && exist_sdp_src=1
exist_sdo_src=0; [ -e /dev/disk/by-label/Sandisk_O ]      && exist_sdo_src=1
exist_sdt_src=0; [ -e /dev/disk/by-label/Sandisk_T ]      && exist_sdt_src=1
exist_sds_src=0; [ -e /dev/disk/by-uuid/EA1D-0944 ]       && exist_sds_src=1
exist_sdu_src=0; [ -e /dev/disk/by-uuid/3166-6338 ]       && exist_sdu_src=1
exist_sdv_src=0; [ -e /dev/disk/by-label/Sandisk_V ]      && exist_sdv_src=1
exist_sdw_src=0; [ -e /dev/disk/by-uuid/3534-6562 ]       && exist_sdw_src=1
exist_sdx_src=0; [ -e /dev/disk/by-label/sandisk_ext ]    && exist_sdx_src=1
exist_sdz_src=0; [ -e /dev/disk/by-label/sandisk_z ]      && exist_sdz_src=1

/usr/bin/expect << EOD
  set timeout 3

  if {$mnt == 0} {
    if {$winX == 1 && $wcb != 0} {
      puts "-winX-"
      sleep 0.5
      spawn sudo umount /media/simone/winX
      expect "password"
      send "$password\r"
    }

    if {$winC == 1 && $wcc != 0} {
      puts "\n\n-winC-"
      sleep 0.5
      spawn sudo umount /media/simone/winC
      expect "password"
      send "$password\r"
    }

    if {$winD == 1 && $wcd != 0} {
      puts "\n\n-winD-"
      sleep 0.5
      spawn sudo umount /media/simone/winD
      expect "password"
      send "$password\r"
    }

    if {$txt == 1 && $wce != 0} {
      puts "\n\n-epub-\n"
      sleep 0.5
      spawn sudo umount /opt/.porn/epub
      expect "password"
      send "$password\r"
    }

    if {$pic == 1 && $wci != 0} {
      puts "\n\n-winC/pics-\n"
      sleep 0.5
      spawn sudo umount /media/simone/winC/pics
      expect "password"
      send "$password\r"

      puts "\n\n-winX/pics-\n"
      sleep 0.5
      spawn sudo umount /media/simone/winX/pics
      expect "password"
      send "$password\r"

      puts "\n\n-winC/vids-\n"
      sleep 0.5
      spawn sudo umount /media/simone/winC/vids
      expect "password"
      send "$password\r"
    }

    if {$aud == 1 && $wca != 0} {
      puts "\n\n-winX/asmr-"
      sleep 0.5
      spawn sudo umount /media/simone/winX/asmr
      expect "password"
      send "$password\r"

      puts "\n\n-porn/asmr-"
      spawn sudo umount /opt/.porn/asmr
      expect "password"
      send "$password\r"
    }

    if {$sdo == 1 && $wco != 0 && $exist_sdo_src == 1} {
      puts "\n\n-ooo-"
      sleep 0.5
      spawn sudo umount /media/simone/sandisk_o
      expect "password"
      send "$password\r"
    }

    if {$sdp == 1 && $wcp != 0 && $exist_sdp_src == 1} {
      puts "\n\n-ppp-"
      sleep 0.5
      spawn sudo umount /media/simone/sandisk_p
      expect "password"
      send "$password\r"
    }

    if {$sdt == 1 && $wct != 0 && $exist_sdt_src == 1} {
      puts "\n\n-ttt-"
      sleep 0.5
      spawn sudo umount /media/simone/sandisk_t
      expect "password"
      send "$password\r"
    }

    if {$sds == 1 && $wcs != 0 && $exist_sds_src == 1} {
      puts "\n\n-sss-"
      sleep 0.5
      spawn sudo umount /media/simone/sandisk_s
      expect "password"
      send "$password\r"
    }

    if {$sdu == 1 && $wcu != 0 && $exist_sdu_src == 1} {
      puts "\n\n-uuu-"
      sleep 0.5
      spawn sudo umount /media/simone/sandisk_u
      expect "password"
      send "$password\r"
    }

    if {$sdv == 1 && $wcv != 0 && $exist_sdv_src == 1} {
      puts "\n\n-vvv-"
      sleep 0.5
      spawn sudo umount /media/simone/sandisk_v
      expect "password"
      send "$password\r"
    }

    if {$sdw == 1 && $wcw != 0 && $exist_sdw_src == 1} {
      puts "\n\n-www-"
      sleep 0.5
      spawn sudo umount /media/simone/sandisk_w
      expect "password"
      send "$password\r"
    }

    if {$sdx == 1 && $wcx != 0 && $exist_sdx_src == 1} {
      puts "\n\n-xxx1-"
      sleep 0.5
      spawn sudo umount /media/simone/sandisk_x1
      expect "password"
      send "$password\r"

      puts "\n\n-xxx2-"
      sleep 0.5
      spawn sudo umount /media/simone/sandisk_x2
      expect "password"
      send "$password\r"
    }

    if {$sdz == 1 && $wcz != 0 && $exist_sdz_src == 1} {
      puts "\n\n-zzz-"
      sleep 0.5
      spawn sudo umount /media/simone/sandisk_z
      expect "password"
      send "$password\r"
    }

    expect eof
    exit
  }

  if {$winX == 1 && $wcx == 0} {
    puts "+winX+"
    sleep 0.5
    spawn sudo mount -o $RWRO,nosuid,nodev,relatime,fmask=0022,dmask=0022,uid=1000,gid=1000 /dev/nvme0n1p4 /media/simone/winX
    expect "password"
    send "$password\r"
  }

  if {$winC == 1 && $wcc == 0} {
    puts "\n\n+winC+"
    sleep 0.5
    spawn sudo mount -o $RWRO,nosuid,nodev,relatime,fmask=0022,dmask=0022,uid=1000,gid=1000 /dev/nvme0n1p3 /media/simone/winC
    expect "password"
    send "$password\r"
  }

  if {$winD == 1 && $wcd == 0} {
    puts "\n\n+winD+"
    sleep 0.5
    spawn sudo mount -o $RWRO,nosuid,nodev,relatime,fmask=0022,dmask=0022,uid=1000,gid=1000 /dev/nvme0n1p5 /media/simone/winD
    expect "password"
    send "$password\r"
  }

  if {$aud == 1 && $wca == 0} {
    puts "\n\n+winX/asmr+"
    spawn sudo mount -t ecryptfs /media/simone/winX/asmr /media/simone/winX/asmr -o ecryptfs_cipher=aes,ecryptfs_key_bytes=16,ecryptfs_passthrough=n,ecryptfs_enable_filename_crypto=y,ecryptfs_fnek_sig=85e5a0a7dcf6b743
    expect "password"
    send "$password\r"
    expect "Passphrase"
    sleep 0.5
    send "$passphrase\r"

    puts "\n\n+porn/asmr+"
    spawn sudo mount -t ecryptfs /opt/.porn/asmr /opt/.porn/asmr -o ecryptfs_cipher=aes,ecryptfs_key_bytes=16,ecryptfs_passthrough=n,ecryptfs_enable_filename_crypto=y,ecryptfs_fnek_sig=85e5a0a7dcf6b743
    expect "password"
    send "$password\r"
    expect "Passphrase"
    sleep 0.5
    send "$passphrase\r"
  }

  if {$sdo == 1 && $wco == 0 && $exist_sdo_src == 1} {
