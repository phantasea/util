#! /bin/bash

SESSION=0

prog="vim"
exe="edit"
diff=0

while getopts "vc:d" opt; do
    case $opt in
        v) 
           prog="view"
           exe="view"
           ;;
        c) cmd="$OPTARG";;
        d) diff=1;;
        ?) echo 'Usage0: vimux [-v]/[-d]/[-c cmd] file/dir'
           exit 1;;
    esac
done

shift $((OPTIND-1))  #This tells getopts to move on to the next argument.

#echo $#
#echo $*
#echo $@
#while [ $# -ne 0 ]; do
#    echo $1
#    shift
#done
##vim $*
#exit 0

#if [ $# -eq 0 -o $# -gt 1 ]; then
#    echo $*
#    echo 'Usage1: vimux [-v] [-c cmd] file/dir'
#    exit 1
#fi

if [ ! -f "$1" ] && [ ! -d "$1" ]; then
    echo $1
    echo 'Usage2: vimux [-v] [-c cmd] file/dir'
    exit 1
fi

file=$1
file=${file// /\\\ }

tmux has-session -t $SESSION
if [ $? -ne 0 ] || [ ! -z "$DISPLAY" ]; then
    $prog $file
    exit 0
fi

cwd=$PWD
cwd=${cwd// /\\\ }

tmux select-window -t vim > /dev/null 2>&1
if [ $? -ne 0 ]; then
    tmux new-window -n vim -t $SESSION:7 "$prog $file"
    tmux select-window -t vim

    if [ $diff -eq 1 ] && [ -f "$2" ]; then
        second=$2
        second=${second// /\\\ }

        tmux set-buffer ":vertical diffsplit $second"
        tmux paste-buffer -t $SESSION:7
        tmux send-keys -t $SESSION:7 C-m
    fi

    exit
fi

tmux send-keys -t $SESSION:7 escape
tmux set-buffer ":cd $cwd"
tmux paste-buffer -t $SESSION:7
tmux send-keys -t $SESSION:7 C-m

tmux set-buffer ":$exe $file"
tmux paste-buffer -t $SESSION:7
tmux send-keys -t $SESSION:7 C-m

if [ $diff -eq 1 ] && [ -f "$2" ]; then
    second=$2
    second=${second// /\\\ }

    tmux set-buffer ":vertical diffsplit $second"
    tmux paste-buffer -t $SESSION:7
    tmux send-keys -t $SESSION:7 C-m

    exit 0
fi

if [ -z "$cmd" ]; then
    exit 0
fi

tmux set-buffer ":$cmd"
tmux paste-buffer -t $SESSION:7
tmux send-keys -t $SESSION:7 C-m

exit 0
