#! /bin/bash

[[ -z "$DISPLAY" ]] && SID=0 || SID=1
[[ -z "$TMUX" ]] && SID=12  #not in tmux session
[[ $(tmux ls | egrep "13:.*attached") ]] && SID=13
[[ "$(tmux display-message -p -F '#{session_name}')" == "nova" ]] && SID="nova"
WID=7
WIN="vim"

#[[ -z "$DISPLAY" ]] && prog="vim" || prog="nvim"
prog="vim"
exe="edit"
diff=0
ignore=0

while getopts "vbc:ds:" opt; do
    case $opt in
        v) 
           #[[ -z "$DISPLAY" ]] && prog="view" || prog="nvim -R"
           prog="view"
           exe="view"
           ;;
        c) cmd="$OPTARG";;
        b) ignore=1;;
        d) 
           diff=1
           #[[ -z "$DISPLAY" ]] && prog="vimdiff" || prog="nvim -d"
           prog="vimdiff"
           WIN="diff"
           WID=3
           ;;
        s)
           search="$OPTARG"
           ;;

        ?) echo 'Usage: vimux [-v]/[-d]/[-b]/[-c cmd]/[-s search] file/dir'
           exit 1;;
    esac
done

shift $((OPTIND-1))  #This tells getopts to move on to the next argument.

#echo "$search" " | " "$1"

if [ ! -f "$1" ] && [ ! -d "$1" ]; then
    echo $1
    echo 'is neither a file nor directory'
    exit 1
fi

maxsize=3000000
#size=$(wc -c < "$1")
#size=$(stat --printf="%s" "$1")
size=$(stat -c %s -- "$1")
if [ $size -gt $maxsize ] && [ $ignore -eq 0 ]; then
    echo "$0: file size $size is large than $maxsize!"
    exit 1
fi

file=$1
file=${file// /\\\ }
file=${file//(/\\\(}
file=${file//)/\\\)}
file=${file//\'/\\\'}
file=${file//\&/\\\&}

tmux has-session -t $SID 2>/dev/null
if [ $? -ne 0 ]; then
    $prog $file
    exit 0
fi

cwd=$PWD
cwd=${cwd// /\\\ }

file2=""
if [ -f "$2" ]; then
    file2=$2
    file2=${file2// /\\\ }
    file2=${file2//(/\\\(}
    file2=${file2//)/\\\)}
fi

tmux select-window -t $SID:$WIN > /dev/null 2>&1
if [ $? -ne 0 ]; then
    #echo $WIN, $SID, $WID, $prog, $file, $file2
    tmux new-window -n $WIN -t $SID:$WID "stty -ixon; $prog $file $file2"
    tmux select-window -t $SID:$WIN

    if [ ! -z "$search" ]; then
        tmux set-buffer "/\V$search"
        tmux paste-buffer -t $SID:$WID
        tmux send-keys -t $SID:$WID C-m
        tmux send-keys -t $SID:$WID zz
    fi

    exit 0
fi

if [ $diff -eq 1 ]; then
    $prog $file $file2
    exit 0
fi

tmux send-keys -t $SID:$WID escape
tmux set-buffer ":cd $cwd"
tmux paste-buffer -t $SID:$WID
tmux send-keys -t $SID:$WID C-m

tmux set-buffer ":$exe $file"
tmux paste-buffer -t $SID:$WID
tmux send-keys -t $SID:$WID C-m

if [ ! -z "$cmd" ]; then
    tmux set-buffer ":$cmd"
    tmux paste-buffer -t $SID:$WID
    tmux send-keys -t $SID:$WID C-m
fi

if [ ! -z "$search" ]; then
    tmux set-buffer "/\V$search"
    tmux paste-buffer -t $SID:$WID
    tmux send-keys -t $SID:$WID C-m
    tmux send-keys -t $SID:$WID zz
fi

exit 0
