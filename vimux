#! /bin/bash

SESSION=0

prog="vim"
exe="edit"

while getopts "vc:" opt; do
    case $opt in
        v) 
           prog="view"
           exe="view"
           ;;
        c) cmd="$OPTARG";;
        ?) echo 'Usage0: vimux [-v] [-c cmd] file'
           exit 1;;
    esac
done

shift $((OPTIND-1))  #This tells getopts to move on to the next argument.

if [ $# -eq 0 -o $# -gt 1 ]; then
    echo 'Usage1: vimux [-v] [-c cmd] file'
    exit 1
fi

if [ ! -f "$1" ]; then
    echo 'Usage2: vimux [-v] [-c cmd] file'
    exit 1
fi

file=$1
file=${file// /\\\ }

tmux has-session -t $SESSION
if [ $? -ne 0 ] || [ ! -z "$DISPLAY" ]; then
    $prog $file
    exit 0
fi

cwd=$PWD
cwd=${cwd// /\\\ }

tmux select-window -t vim > /dev/null 2>&1
if [ $? -ne 0 ]; then
    tmux new-window -n vim -t $SESSION:7 "$prog $file"
    tmux select-window -t vim
    exit
fi

tmux send-keys escape
tmux set-buffer ":cd $cwd"
tmux paste-buffer
tmux send-keys C-m

tmux set-buffer ":$exe $file"
tmux paste-buffer
tmux send-keys C-m

if [ -z "$cmd" ]; then
    exit 0
fi

tmux set-buffer ":$cmd"
tmux paste-buffer
tmux send-keys C-m

exit 0
