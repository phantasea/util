#!/bin/bash

### getopts {{{
OPTS=""
POPS=0
TEMP=0
MOVE=0
TRAV=0
while getopts "BPTXY" opt; do
    case $opt in
        B)  OPTS="-B" ;;
        P)  POPS=1    ;;
        T)  TEMP=1    ;;
        X)  MOVE=1    ;;
        Y)  TRAV=1   ;;
        ?)  echo 'Usage: scratchpad [-BPTXY]'
            exit 1;;
    esac
done
shift $((OPTIND-1))
### }}}

### tmux in i3wm {{{
### called by bashrc
if [[ ! -z $DISPLAY ]]; then
    if [[ ! -z $I3_SCRATCHPAD ]]; then
        [[ "$I3_SCRATCHPAD" == "VIFM" ]] && APP=vifmrun || APP=ranger
        tmux -L x-serv new-session -A -s nova -n nova $APP
    fi

    exit 0
fi
### }}}

### tmux in fbterm {{{
SID="${1:-pops}"
APP="${2:-fffm}"
WIDTH=${3:-81%}
HEIGHT=${4:-64%}

# tmux display-message -p -d 5000 -t session_name:window_index.pane_index
# tmux display-message == "[1] 7:vim, current pane 1 - (11:13 27-May-23)"
# [#{session_name}] #{window_index}:#{window_name}, current #{pane_index}
CURR_SID=$(tmux display-message -p -F '#{session_name}')
CURR_WID=$(tmux display-message -p -F '#{window_index}')
CURR_WIN=$(tmux display-message -p -F '#{window_name}')

if [[ $CURR_WIN =~ vidplay && $CURR_SID != temp ]]; then
    tmux send-keys space
fi

POPUP="tmux popup $OPTS -E -xC -yC"
if [ $POPS -eq 1 ]; then
    if [[ "$CURR_SID" == $SID ]]; then
        tmux detach-client
    elif [[ ! "$CURR_SID" =~ (asmr|nova|temp) ]]; then
        $POPUP -w$WIDTH -h$HEIGHT "tmux attach-s -t $SID || tmux new-s -s $SID $APP"
    else
        tmux detach-client
        $POPUP -w$WIDTH -h$HEIGHT "tmux attach-s -t $SID || tmux new-s -s $SID $APP"
    fi

    exit 0
fi

if [ $MOVE -eq 1 ]; then
    [[ $CURR_WIN =~ (bash|vim|vifm|ranger) ]] && exit 0

    if [[ "$CURR_SID" == "temp" ]]; then
        tmux move-w -s $CURR_SID:$CURR_WID -t 0:$CURR_WID
        tmux detach-client
        exit 0
    fi

    tmux has-s -t temp || tmux new-s -d -s temp
    sleep 0.1
    tmux move-w -s $CURR_SID:$CURR_WID -t temp:$CURR_WID
    tmux has-s -t temp:bash 2>/dev/null && tmux kill-w -t temp:bash

    exit 0
fi

if [ $TEMP -eq 1 ]; then
    tmux has-session -t temp || exit 0
    if [[ "$CURR_SID" == "temp" ]]; then
        #if [[ $CURR_WIN =~ vidplay ]]; then
        #    tmux send-keys space
        #fi
        tmux detach-client
    elif [[ ! "$CURR_SID" =~ (asmr|nova|temp) ]]; then
        $POPUP -w80% -h80% "tmux attach-s -t temp"
    fi

    exit 0
fi

HAS_SESS="tmux has-session -t"
if [ $TRAV -eq 1 ]; then  ### {{{
    # this cycle-thru way shows each client/session NOT as POPUP
    #tmux switch-client -n && exit 0

    if [[ $CURR_SID == 0 ]]; then
        $HAS_SESS asmr 2>/dev/null && $POPUP -B -w64% -h64% "tmux attach-s -t asmr" && exit 0
        $HAS_SESS nova 2>/dev/null && $POPUP    -w81% -h64% "tmux attach-s -t nova" && exit 0
        $HAS_SESS temp 2>/dev/null && $POPUP    -w80% -h80% "tmux attach-s -t temp" && exit 0
        exit 0
    fi

    if [[ "$CURR_SID" == "asmr" ]]; then
        tmux detach-client -s asmr
        $HAS_SESS nova 2>/dev/null && $POPUP    -w81% -h64% "tmux attach-s -t nova" && exit 0
        $HAS_SESS temp 2>/dev/null && $POPUP    -w80% -h80% "tmux attach-s -t temp" && exit 0
        exit 0
    fi

    if [[ "$CURR_SID" == "nova" ]]; then
        tmux detach-client -s nova
        $HAS_SESS temp 2>/dev/null && $POPUP    -w80% -h80% "tmux attach-s -t temp" && exit 0
       #$HAS_SESS asmr 2>/dev/null && $POPUP -B -w64% -h64% "tmux attach-s -t asmr" && exit 0
        exit 0
    fi

    if [[ $CURR_SID == "temp" ]]; then
        tmux detach-client -s temp
       #$HAS_SESS asmr 2>/dev/null && $POPUP -B -w64% -h64% "tmux attach-s -t asmr" && exit 0
       #$HAS_SESS nova 2>/dev/null && $POPUP    -w81% -h64% "tmux attach-s -t nova" && exit 0
        exit 0
    fi

    exit 0
fi
### }}}
### }}}
exit 0

### For tmux-3.0a(/opt/misc/appimg/tmux.appimage) {{{
tmux -L default has-session -t 13 2>/dev/null || tmux new-s -d -s 13 "clear; screenfetch"

#nova_cmd="fffm /opt/.porn/eros"
nova_cmd="ranger /opt/.porn/eros"
tmux list-w -t 13 2>/dev/null | grep nova > /dev/null || tmux new-w -n nova -t 13:11 $nova_cmd

asmr_cmd="mocp -v 60 /opt/.porn/auds"
tmux list-w -t 13 2>/dev/null | grep asmr > /dev/null || tmux new-w -n asmr -t 13:13 $asmr_cmd
