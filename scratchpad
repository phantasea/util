#!/bin/bash

if [ ! -z $DISPLAY ]; then
    if [[ "$I3_SCRATCHPAD" == "YES" ]]; then
        tmux -L x-serv has-session -t 9 2>/dev/null \
            || tmux -L x-serv new-session -s 9 vifmrun
    fi

    exit 0
fi

tmux -L default has-session -t 13 2>/dev/null || tmux new-session -d -s 13

nova_cmd="fffm /opt/.porn/text"
tmux list-w -t 13 2>/dev/null | grep nova > /dev/null || tmux new-w -n nova -t 13:12 $nova_cmd

asmr_cmd="mocp /opt/.porn/asmr"
tmux list-w -t 13 2>/dev/null | grep asmr > /dev/null || tmux new-w -n asmr -t 13:13 $asmr_cmd
#tmux send-keys -t 13:asmr "/asmr.m3u" C-m)
