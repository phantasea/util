#! /bin/bash

shopt -s nullglob
shopt -s globstar
shopt -s nocaseglob

recursive="FALSE"
slideshow="FALSE"

SID=0
WID=12
WIN="fim"
CMD="fim"

#If an option should be followed by an argument, it should be followed by a ":".
#The leading ":" suppresses error messages from getopts.
#while getopts ":rsd:" opt; do
while getopts "rsd:" opt; do
    case $opt in
        r) recursive="TRUE";;
        s) slideshow="TRUE";;
        d) 
           if [ -d "$OPTARG" ]; then
               cd "$OPTARG"
           else
               echo 'option -d must be followed by directory'
               exit 1
           fi
           ;;
        ?) echo 'Usage: imgview [-r] [-s] [-d dir] [file]'
           exit 1;;
    esac
done

shift $((OPTIND-1))  #This tells getopts to move on to the next argument.

if [ $# -gt 1 ]; then
    echo "Only one file supported!"
    exit 1
fi

file=$1
if [ ! -z "$file" -a ! -f "$file" ]; then
    echo "$file is not a file!"
    exit 1
fi

