#! /bin/bash

shopt -s nullglob
shopt -s globstar
shopt -s nocaseglob

ALT="FALSE"
recursive="FALSE"
slideshow="FALSE"

if [ -z "$DISPLAY" ]; then
    SID=0
else
    SID=1
fi

WID=11
WIN="imgview"
CMD=""
PROG=""

#If an option should be followed by an argument, it should be followed by a ":".
#The leading ":" suppresses error messages from getopts.
#while getopts ":brsd:" opt; do
while getopts "brsd:" opt; do
    case $opt in
        b) ALT="TRUE";;
        r) recursive="TRUE";;
        s) slideshow="TRUE";;
        d) 
           if [ -d "$OPTARG" ]; then
               cd "$OPTARG"
           else
               echo 'option -d must be followed by a directory!'
               exit 1
           fi
           ;;
        ?) echo 'Usage: imgview [-b] [-r] [-s] [-d dir] <file>'
           exit 1;;
    esac
done

shift $((OPTIND -1))  #This tells getopts to move on to the next argument.

file=$1
if [ ! -z "$file" -a ! -f "$file" ]; then
    echo "$file is not a file!"
    exit 1
fi

# console
if [ -z "$DISPLAY" ]; then
    PROG="fim"
    if [ "$ALT" = "TRUE" ]; then
        PROG="fbv"
    fi

    if [ "$slideshow" = "TRUE" ]; then
        if [ "$ALT" = "FALSE" ]; then
            PROG+=" -c \"endless_slideshow\""
        else
            PROG+=" -s 10"
        fi
    fi
# xwindow
else
    PROG="pho -p"
    if [ "$ALT" = "TRUE" ]; then
        PROG="feh -F"
        #PROG="pqiv"
    fi

    if [ "$slideshow" = "TRUE" ]; then
        if [ "$ALT" = "FALSE" ]; then
            PROG+=" -s1"
        else
            PROG+=" -D 1"
        fi
    fi
fi

FILES="$file"
if [ "$recursive" = "FALSE" ]; then
    FILES+=" *.{jpg,jpeg,png,bmp,gif,ppm,xpm}"
else
    FILES+=" {,**/}*.{jpg,jpeg,png,bmp,gif,ppm,xpm}"
fi

CMD="$PROG $FILES > /dev/null 2>&1"

tmux has-session -t $SID
if [ $? -ne 0 ]; then
    setterm -cursor off; $CMD
    exit 0
fi

tmux select-window -t $SID:$WIN > /dev/null 2>&1
if [ $? -ne 0 ]; then
    tmux new-window -n $WIN -t $SID:$WID "setterm -cursor off; $CMD"
fi

exit 0
