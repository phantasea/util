#    file=${file// /\\\ }
#    file=${file##*/}  
#    #file=`basename "$file"`  #This is another way to get the base file name.
#    #file_BASE=`echo "${file%.*}"`  #file without extension
#    #file_EXT="${file##*.}"  #file extension
#
#    echo "$file"
#    shift  #Move on to next input file.
#done
#exit 0

#console
if [ -z "$DISPLAY" ]; then
    if [ "$recursive" = "FALSE" ]; then
        if [ "$slideshow" = "FALSE" ]; then
            CMD="fim \"$file\" *.{jpg,jpeg,png,bmp,gif,ppm,xpm} > /dev/null 2>&1"
        else
            CMD="fim -c \"endless_slideshow\" *.{jpg,jpeg,png,bmp,gif,ppm,xpm} > /dev/null 2>&1"
        fi
    else
        if test "$slideshow" = "FALSE"; then
            CMD="fim \"$file\" {,**/}*.{jpg,jpeg,png,bmp,gif,ppm,xpm} > /dev/null 2>&1"
        else
            CMD="fim -c \"endless_slideshow\" {,**/}*.{jpg,jpeg,png,bmp,gif,ppm,xpm} > /dev/null 2>&1"
        fi
    fi

    tmux has-session -t $SID
    if [ $? -ne 0 ]; then
        setterm -cursor off; $CMD
        exit 0
    fi

    tmux select-window -t $WIN > /dev/null 2>&1
    if [ $? -ne 0 ]; then
        tmux new-window -n $WIN -t $SID:$WID "setterm -cursor off; $CMD"
    fi
#xwindow
else
    if [ "$recursive" = "FALSE" ]; then
        if [ "$slideshow" = "FALSE" ]; then
            pho -p "$file" *.{jpg,jpeg,png,bmp,gif,ppm,xpm} > /dev/null 2>&1 &
        else
            pho -p -s1 *.{jpg,jpeg,png,bmp,gif,ppm,xpm} > /dev/null 2>&1 &
        fi
    else
        if test "$slideshow" = "FALSE"; then
            pho -p "$file" **/*.{jpg,jpeg,png,bmp,gif,ppm,xpm} > /dev/null 2>&1 &
        else
            pho -p -s1 **/*.{jpg,jpeg,png,bmp,gif,ppm,xpm} > /dev/null 2>&1 &
        fi
    fi
fi

exit 0
