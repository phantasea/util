#!/bin/bash

SID=0
WID=6
WIN="mplayer"
CMD=""

fullscreen=0

while getopts "f" opt; do
    case $opt in
        f) fullscreen=1;;
        ?) echo 'Usage0: vidmux [-f] file'
           exit 1;;
    esac
done

shift $((OPTIND-1))

if [ ! -z "$DISPLAY" ]; then
    if [ ! -f "$1" ]; then
        echo "$1 is not a file"
        exit 1
    fi

    #totem "$1" &
    mplayer -really-quiet -fs "$1"
    exit 0
fi

if [ $# -gt 1 ] || [ $# -eq 0 ]; then
    echo 'Usage1: vidmux [-f] file'
    exit 1
fi

if [ ! -f "$1" ]; then
    echo 'Usage2: vidmux [-f] file'
    exit 1
fi

if [ $fullscreen -eq 0 ]; then
    CMD="mplayer -really-quiet -vo fbdev2 \"$1\""
else 
    CMD="mplayer -really-quiet -vo fbdev2 -xy 1024 -fs -zoom \"$1\""
fi

tmux has-session -t $SID
if [ $? -ne 0 ]; then
    setterm -cursor off; $CMD
    exit 0
fi

tmux select-window -t $WIN > /dev/null 2>&1
if [ $? -ne 0 ]; then
    tmux new-window -n $WIN -t $SID:$WID "setterm -cursor off; $CMD"
fi

exit 0
