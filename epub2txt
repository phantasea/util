#!/usr/bin/bash

if [ ! -f "$1" ]; then
    echo $1
    echo 'is not a file!'
    exit 1
fi

filename=$(basename -- "$1")
fileext="${filename##*.}"
filebase="${filename%.*}"
#echo $filename

shopt -s nocasematch
if [[ "$fileext" != "epub" ]]; then
    echo $1, $fileext
    echo "Not an EPUB file!"
    exit 2
fi

filepath=$(realpath -- "$1")
dirname=$(dirname -- "$filepath")
cd -- "$dirname"

 /opt/util/bins/epub2txt1 -r "$filename"  > "$filebase".txt
#/opt/util/bins/epub2txt2 -f "$filename" 2> /dev/null
#/opt/util/bins/epub2txt3    "$filename"  > /dev/null

exit 0

