#! /bin/bash

SID=0
WID=9
WIN='vifm'
CMD='vifm'

while getopts "e" opt; do
    case $opt in
        e) 
           CMD='ranger --confdir=/home/simone/.ranger'
           WIN='ranger'
           WID=11
           ;;
        ?) echo 'Usage0: fmux [-e]'
           exit 1;;
    esac
done

shift $((OPTIND-1))  #This tells getopts to move on to the next argument.

if [ $# -ne 0 ]; then
    echo 'Usage1: fmux [-e]'
    exit 1
fi

if [ ! -z "$DISPLAY" ]; then
    ranger
    exit 0
fi

tmux has-session -t $SID
if [ $? -ne 0 ]; then
    $CMD
    exit 0
fi

tmux select-window -t $WIN > /dev/null 2>&1
if [ $? -ne 0 ]; then
    #tmux new-window -n $WIN -t $SID:$WID 'DISPLAY=:0.0 $CMD'
    tmux new-window -n $WIN -t $SID:$WID "$CMD"
fi

exit 0
