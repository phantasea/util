#!/bin/bash

[[ -z "$DISPLAY" ]] && SID=0 || SID=1
[[ ! "$TERM" =~ "screen" ]] && SID=12    #not in tmux session
[[ $(tmux ls | egrep "13:.*attached") ]] && SID=13

background=0
while getopts "b" opt; do
    case $opt in
        b)  background=1 ;;

        ?)  echo 'Usage: autocd [-b]'
            exit 1;;
    esac
done
shift $((OPTIND-1))

tmux list-w | egrep "ranger\*|vifm\*|vifmrun\*" > /dev/null 2>&1
if [ $? -ne 0 ]; then
    exit 0
fi

tmux send-keys gY
sleep 0.1

tmux select-window -t $SID:1 > /dev/null 2>&1
if [ $? -ne 0 ]; then
    exit 0
fi

if [ -z "$DISPLAY" ]; then
    tmux send-keys C-u
    tmux send-keys "cd "
    sleep 0.1
    tmux send-keys "$(tmux paste-buffer)"
    tmux send-keys C-m
    [[ $background -eq 1 ]] && tmux select-window -l
    exit 0
fi

tmux send-keys C-u
tmux send-keys "cd $(xclip -o -sel clip)"
tmux send-keys C-m
[[ $background -eq 1 ]] && tmux select-window -l
exit 0
