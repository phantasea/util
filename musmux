#!/bin/bash

if [ -z "$DISPLAY" ]; then
    CMD="mocp"
else
    CMD="ncmpc -f ~/.config/ncmpc/config -k ~/.config/ncmpc/keys"
fi

[[ -z "$DISPLAY" ]] && SID=0 || SID=1
[[ -z "$TMUX" ]] && SID=12  #not in tmux session
[[ $(tmux ls | egrep "13:.*attached") ]] && SID=13
WID=6
WIN="music"
OPTS=""

while getopts "bdB" opt; do
    case $opt in
        d)
            OPTS="-d"
            WID=13
            WIN="asmr"
            if [ ! -z "$DISPLAY" ]; then
                exit 0
            fi
            ;;
        b)
            if [ -z "$DISPLAY" ]; then
                CMD="ncmpc -f ~/.config/ncmpc/config -k ~/.config/ncmpc/keys"
            else
                CMD="mocp"
            fi
            ;;

        B)
            CMD="vimpc"
            ;;

        ?)  echo 'Usage: musmux [-bdB]'
            exit 1;;
    esac
done
shift $((OPTIND-1))

tmux has-session -t $SID 2>/dev/null
if [ $? -ne 0 ]; then
    $CMD
    exit 0
fi

tmux select-window -t $SID:$WIN > /dev/null 2>&1
if [ $? -ne 0 ]; then
    tmux new-window $OPTS -n $WIN -t $SID:$WID "stty -ixon; $CMD"
    if [[ "$CMD" =~ "mocp" ]]; then
        if [[ -z "$DISPLAY" && "$WIN" =~ "asmr" ]]; then
                sleep 1s
                tmux list-w -t 13 >/dev/null 2>&1 && tmux move-w -s 0:13 -t 13:13
                sleep 1s
                tmux send-keys -t 13:13 "/fave" C-m
                sleep 1s
                tmux send-keys -t 13:13 w
                sleep 1s
                tmux send-keys -t 13:13 "=/opt/.porn/asmr" C-m
                exit 0
        fi
    fi

