#!/bin/bash

if [ -z "$DISPLAY" ]; then
    CMD="mocp"
else
    CMD="ncmpc -f ~/.config/ncmpc/config -k ~/.config/ncmpc/keys"
fi

SID=0
WID=6
WIN="music"

[[ ! -z "$DISPLAY" ]] && SID=1

# not in tmux session
[[ ! "$TERM" =~ "screen" ]] && SID=13

while getopts "b" opt; do
    case $opt in
        b)
            if [ -z "$DISPLAY" ]; then
                CMD="ncmpc -f ~/.config/ncmpc/config -k ~/.config/ncmpc/keys"
            else
                CMD="mocp"
            fi
            ;;

        ?)  echo 'Usage: musmux [-b]'
            exit 1;;
    esac
done
shift $((OPTIND-1))

tmux has-session -t $SID 2>/dev/null
if [ $? -ne 0 ]; then
    $CMD
    exit 0
fi

tmux select-window -t $SID:$WIN > /dev/null 2>&1
if [ $? -ne 0 ]; then
    tmux new-window -n $WIN -t $SID:$WID "stty -ixon; $CMD"
    if [[ "$CMD" =~ "mocp" ]]; then
        tmux send-keys -t $SID:$WID "/myfav" C-m
        tmux send-keys -t $SID:$WID M
        tmux send-keys -t $SID:$WID C-i
        tmux send-keys -t $SID:$WID "/misc" C-m
        tmux send-keys -t $SID:$WID G
        tmux send-keys -t $SID:$WID C-i
        #sleep 1s
        #tmux split-window -v
        #tmux send-keys -t $SID:$WID "ccal -u" C-m
        #tmux select-pane -l
        #tmux split-window -h "tty-clock -c -C 3"
        #tmux resize-pane -R 16
        #tmux select-pane -L
        #tmux swap-pane -D
    fi

    if [[ "$CMD" =~ "ncmpc" ]]; then
        tmux send-keys -t $SID:$WID M
        tmux split-window -h -t $SID:$WID
        tmux send-keys -t $SID:$WID "cd ~/auds" C-m
        tmux send-keys -t $SID:$WID "fd -t=f -e=mp3 . ~/auds | sed -e 's#.*/auds/##' | fzf --height=0 --inline-fino --bind 'ctrl-o:execute-silent(fzfopen {})'" C-m
        tmux select-pane -l -t $SID:$WID
    fi
fi

exit 0
