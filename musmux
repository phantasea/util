#!/bin/bash

SID=0
WID=5
WIN="music"
CMD="mocp"

if [ ! -z "$DISPLAY" ]; then
    $CMD
    exit 0
fi

tmux has-session -t $SID
if [ $? -ne 0 ]; then
    $CMD
    exit 0
fi

tmux select-window -t $WIN > /dev/null 2>&1
if [ $? -ne 0 ]; then
    tmux new-window -n $WIN -t $SID:$WID $CMD
    tmux send-keys -t $SID:$WID "G"
    #sleep 1s
    #tmux split-window -v
    #tmux send-keys -t $SID:$WID "ccal -u" C-m
    #tmux select-pane -l
    #tmux split-window -h "tty-clock -c -C 3"
    #tmux resize-pane -R 16
    #tmux select-pane -L
    #tmux swap-pane -D
fi

exit 0
