#! /bin/bash

SESSION=0

#prog="cd ~; TERM=jfbterm w3m -s"
cmd="w3m -s"
prog="cd ~; w3m -s"

while getopts "e" opt; do
    case $opt in
        e) 
           prog="elinks"
           cmd="elinks"
           ;;
        ?) echo 'Usage0: wemux [-e] target'
           exit 1;;
    esac
done

shift $((OPTIND-1))  #This tells getopts to move on to the next argument.

if [ $# -gt 1 ]; then
    echo 'Usage1: wemux [-e] target'
    exit 1
fi

tmux has-session -t $SESSION
if [ $? -ne 0 ] || [ ! -z "$DISPLAY" ]; then
    cd ~

    if [ -z "$1" ]; then
        $cmd .
    else
        $cmd "$1"
    fi

    exit 0
fi

target="."
if [ ! -z "$1" ]; then
    if [ -f "$1" ] || [ -d "$1" ]; then
        target=$(realpath -s "$1")
        target="file://${target}"
    else
        #if [ "${1:0:3}" = "www" ]; then
        #    target="http://"${1}
        #fi
        target="http://"${1}
    fi
fi

#echo "$target"

tmux select-window -t web > /dev/null 2>&1
if [ $? -ne 0 ]; then
    tmux new-window -n web -t $SESSION:8 "$prog \"$target\""
else
    tmux send-keys -t $SESSION:8 T
    if [ "$prog" = "elinks" ]; then
        tmux send-keys -t $SESSION:8 o
    fi
    tmux set-buffer "$target"
    tmux paste-buffer -t $SESSION:8
    tmux send-keys -t $SESSION:8 C-m
fi

exit 0
