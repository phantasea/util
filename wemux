#! /bin/bash

SID=0
WID=8
WIN="web"

#prog="cd ~; TERM=jfbterm w3m -s"
cmd="w3m -s"
prog="cd ~; w3m -s"

while getopts "e" opt; do
    case $opt in
        e) 
           prog="elinks"
           cmd="elinks"
           ;;
        ?) echo 'Usage0: wemux [-e] URI'
           exit 1;;
    esac
done

shift $((OPTIND-1))  #This tells getopts to move on to the next argument.

if [ $# -gt 1 ]; then
    echo 'Usage1: wemux [-e] URI'
    exit 1
fi

tmux has-session -t $SID
if [ $? -ne 0 ] || [ ! -z "$DISPLAY" ]; then
    cd ~

    if [ -z "$1" ]; then
        $cmd .
    else
        $cmd "$1"
    fi

    exit 0
fi

URI="."
if [ ! -z "$1" ]; then
    if [ -f "$1" ] || [ -d "$1" ]; then
        URI=$(realpath -s "$1")
        URI="file://${URI}"
    else
        #if [ "${1:0:3}" = "www" ]; then
        #    URI="http://"${1}
        #fi
        URI="http://"${1}
    fi
fi

tmux select-window -t $WIN > /dev/null 2>&1
if [ $? -ne 0 ]; then
    tmux new-window -n $WIN -t $SID:$WID "$prog \"$URI\""
else
    tmux send-keys -t $SID:$WID T
    if [ "$prog" = "elinks" ]; then
        tmux send-keys -t $SID:$WID o
    fi
    tmux set-buffer "$URI"
    tmux paste-buffer -t $SID:$WID
    tmux send-keys -t $SID:$WID C-m
fi

exit 0
