#!/bin/bash

[[ -z "$DISPLAY" ]] && SID=0 || SID=1
[[ ! "$TERM" =~ "screen" ]] && SID=13    #not in tmux session
WID=5
WIN="vidplay"

[[ -z "$DISPLAY" ]] && CMD="mplayer" || CMD="mpv 2>/dev/null"

while getopts "bB" opt; do
    case $opt in
        b)
            if [[ $CMD =~ "mplayer" ]]; then
                CMD+=" -nofs -xy 768"
            else
                CMD+=" --no-fs 2>/dev/null"
            fi
            ;;
        B)
            if [ -z "$DISPLAY" ]; then
                CMD="mpv --vo=drm 2>/dev/null"
            else
                CMD="mplayer -vo x11"
            fi
            ;;
        ?)
            echo 'Usage: vidmux [-bB] <file>'
            exit 1;;
    esac
done

#echo $CMD

shift $((OPTIND-1))  #This tells getopts to move on to the next argument.

if [ $# -gt 1 ] || [ $# -eq 0 ]; then
    echo 'Usage1: vidmux [-bB] <file>'
    exit 1
fi

if [ ! -f "$1" ]; then
    echo 'Usage2: vidmux [-bB] <file>'
    exit 1
fi

# cannot switch between mpv and other window
tmux has-session -t $SID 2>/dev/null
if [[ $? -ne 0 ]] || [[ $CMD =~ "mpv" ]]; then
    $CMD "$1"
    exit 0
fi

tmux select-window -t $SID:$WIN > /dev/null 2>&1
if [ $? -ne 0 ]; then
    tmux new-window -n $WIN -t $SID:$WID "setterm -cursor off; $CMD \"$1\""
fi

exit 0
