#!/bin/bash

OPTS="-"
while getopts "bB" opt; do
    case $opt in
        b)
            OPTS+="b" ;;
        B)
            OPTS+="B" ;;
        ?)
            echo 'Usage: fileopen [-bB] <file>'
            exit 1;;
    esac
done
shift $((OPTIND-1))  #This tells getopts to move on to the next argument.

if [ $OPTS = "-" ]; then
    OPTS=""
fi

[ $# -eq 0 ] && exit 1

file="$*"
if [[ $* =~ '\' ]]; then
    file=${file// /\\\ }
    file=${file//(/\\\(}
    file=${file//)/\\\)}
fi

#echo $file
if [ ! -f "$file" ]; then
    echo 'Usage1: fileopen [-bB] <file>'
    exit 1
fi

MAXSIZE=3000000
#size=$(wc -c < "$1")
#size=$(stat --printf="%s" "$1")
size=$(stat -c %s -- "$1")

ext="${file##*.}"
ext=$(echo ${ext} | tr '[:upper:]' '[:lower:]')

case "$ext" in
    mp3|wav|flac|ogg|w4a|wma|ape|rm)
        audplay $OPTS "$file"
        ;;

    rmvb|rmb|swf|avi|mp4|wmv|3gp|ogv|mkv|mpg|vob|flv|rmvb|rmb|vdat|webm)
        vidplay $OPTS "$file"
        ;;

    bmp|jpg|jpeg|png|gif|xpm|ppm)
        imgview $OPTS "$file"
        ;;

    htm|html|xhtml)
        webview $OPTS "$file"
        ;;

    pdf|ps)
        if [ $size -gt $MAXSIZE ]; then
            echo "The file size is too large! ($size > $MAXSIZE)"
            exit 1
        fi
        pdfview $OPTS "$file"
        ;;

    tpp)
        tpp "$file"
        ;;

    *)
        if [ $size -gt $MAXSIZE ]; then
            echo "The file size is too large! ($size > $MAXSIZE)"
            exit 1
        fi
        vimux "$file"
        ;;
esac

exit 0
