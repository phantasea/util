#!/bin/bash

ALT=0
while getopts "bB" opt; do
    case $opt in
        b)
            ((ALT+=1)) ;;
        B)
            ((ALT+=2)) ;;
        ?)
            echo 'Usage: fileopen [-bB] <file>'
            exit 1;;
    esac
done

shift $((OPTIND-1))  #This tells getopts to move on to the next argument.

[ $# -eq 0 ] && exit 1

file="$*"
if [[ $* =~ '\' ]]; then
    file=${file// /\\\ }
    file=${file//(/\\\(}
    file=${file//)/\\\)}
fi

#echo "$file"

if [ ! -f "$file" ]; then
    echo 'Usage1: fileopen [-bB] <file>'
    exit 1
fi

ext="${file##*.}"
ext=$(echo ${ext} | tr '[:upper:]' '[:lower:]')

case "$ext" in
    mp3|wav|flac|ogg|w4a|wma|ape|rm)
        if [ $ALT = 0 ]
        then
            audplay "$file"
        elif [ $ALT = 1 ]
        then
            audplay -b "$file"
        elif [ $ALT = 2 ]
        then
            audplay -B "$file"
        else
            echo "ALT=$ALT incorrect!"
            exit 1
        fi
        ;;

    rmvb|rmb|swf|avi|mp4|wmv|3gp|ogv|mkv|mpg|vob|flv|rmvb|rmb|vdat|webm)
        if [ $ALT -eq 0 ]; then
            vidplay "$file"
        elif [ $ALT -eq 1 ]; then
            vidplay -b "$file"
        elif [ $ALT -eq 2 ]; then
            vidplay -B "$file"
        elif [ $ALT -eq 3 ]; then
            vidplay -bB "$file"
        else
            echo "ALT=$ALT incorrect!"
            exit 1
        fi
        ;;

    bmp|jpg|jpeg|png|gif|xpm|ppm)
        if [ $ALT -eq 0 ]; then
            imgview "$file"
        else
            imgview -b "$file"
        fi
        ;;

    htm|html|xhtml)
        if [ $ALT -eq 0 ]; then
            webview "$file"
        elif [ $ALT -eq 1 ]; then
            webview -b "$file"
        elif [ $ALT -eq 2 ]; then
            webview -B "$file"
        else
            echo "ALT=$ALT incorrect!"
            exit 1
        fi
        ;;

    pdf|ps)
        if [ $ALT -eq 0 ]; then
            pdfview "$file"
        else
            pdfview -b "$file"
        fi
        ;;

    tpp)
        tpp "$file"
        ;;

    *)
        vimux "$file"
        ;;
esac

exit 0
